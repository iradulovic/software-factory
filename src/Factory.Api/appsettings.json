{
  "Factory": {
    "ConnectionString": "Host=localhost;Port=5432;Database=software_factory;Username=factory;Password=factory",
    "RootDirectory": "./factory-data",
    "TaskConcurrency": 1,
    "PollingIntervalSeconds": 10
  },
  "Agents": {
    "Profiles": [
      {
        "Name": "Codex",
        "Executable": "codex",
        "Arguments": [],
        "PromptDelivery": "stdin",
        "TimeoutMinutes": 90,
        "QuotaSignatures": ["quota", "usage limit"],
        "VersionArguments": ["--version"],
        "AuthenticationArguments": ["login", "status"],
        "AuthenticationCacheSeconds": 30,
        "AvailabilityTimeoutSeconds": 5,
        "QuotaCooldownHours": 5,
        "QuotaResetPattern": "(?:resets?|try again)\\s+(?:at|in)\\s+(?<value>\\d{1,2}(?::\\d{2})?\\s*[ap]\\.?m\\.?|\\d+(?:\\.\\d+)?\\s*(?:hours?|hrs?|h|minutes?|mins?|m|days?|d))",
        "SupportsSessionResume": false,
        "SessionIdPattern": "session id: (?<sessionId>[0-9a-fA-F-]{36})",
        "Provider": "Codex",
        "Classes": [
          {
            "TaskClass": "quick",
            "Model": "gpt-5.6-luna",
            "ReasoningEffort": "max",
            "Arguments": ["exec", "-m", "gpt-5.6-luna", "-c", "model_reasoning_effort=\"max\"", "--approve-for-me", "-"],
            "ResumeArguments": ["exec", "resume", "{SESSION_ID}", "-m", "gpt-5.6-luna", "-c", "model_reasoning_effort=\"max\"", "--dangerously-bypass-approvals-and-sandbox", "-"]
          },
          {
            "TaskClass": "deep",
            "Model": "gpt-5.6-sol",
            "ReasoningEffort": "medium",
            "Arguments": ["exec", "-m", "gpt-5.6-sol", "-c", "model_reasoning_effort=\"medium\"", "--approve-for-me", "-"],
            "ResumeArguments": ["exec", "resume", "{SESSION_ID}", "-m", "gpt-5.6-sol", "-c", "model_reasoning_effort=\"medium\"", "--dangerously-bypass-approvals-and-sandbox", "-"]
          }
        ]
      },
      {
        "Name": "Claude",
        "Executable": "claude",
        "Arguments": ["--print", "--model", "claude-sonnet-5", "--effort", "medium", "--dangerously-skip-permissions"],
        "PromptDelivery": "argument",
        "TimeoutMinutes": 90,
        "QuotaSignatures": ["rate limited"],
        "VersionArguments": ["--version"],
        "AuthenticationArguments": ["auth", "status"],
        "AuthenticationCacheSeconds": 30,
        "AvailabilityTimeoutSeconds": 5,
        "QuotaCooldownHours": 5,
        "QuotaResetPattern": "(?:resets?|try again)\\s+(?:at|in)\\s+(?<value>\\d{1,2}(?::\\d{2})?\\s*[ap]\\.?m\\.?|\\d+(?:\\.\\d+)?\\s*(?:hours?|hrs?|h|minutes?|mins?|m|days?|d))",
        "SupportsSessionResume": false,
        "SessionIdPattern": "\"session_id\":\"(?<sessionId>[0-9a-fA-F-]{36})\"",
        "ResumeArguments": ["--print", "--output-format", "json", "--resume", "{SESSION_ID}", "--model", "claude-sonnet-5", "--effort", "medium", "--dangerously-skip-permissions"]
      },
      {
        "Name": "Pi",
        "Executable": "pi",
        "Arguments": ["--print", "--model", "moonshotai/kimi-k2.6"],
        "PromptDelivery": "stdin",
        "TimeoutMinutes": 90,
        "QuotaSignatures": null,
        "VersionArguments": ["--version"],
        "AuthenticationArguments": ["auth", "check", "--model", "moonshotai/kimi-k2.6", "--no-refresh"],
        "AuthenticationCacheSeconds": 30,
        "AvailabilityTimeoutSeconds": 5,
        "QuotaCooldownHours": 5,
        "Provider": "MoonshotAI",
        "Model": "moonshotai/kimi-k2.6",
        "AllowAutomaticFallback": false
      }
    ]
  },
  "GitHub": {
    "AvailabilityTimeoutSeconds": 5
  },
  "Dashboard": {
    "Url": "http://localhost:3000"
  },
  "AllowedHosts": "*"
}
