{
  "Factory": {
    "ConnectionString": "Host=localhost;Port=5432;Database=software_factory;Username=factory;Password=factory",
    "RootDirectory": "./factory-data",
    "TaskConcurrency": 1,
    "PollingIntervalSeconds": 10,
    "TaskLeaseSeconds": 600,
    "LeaseHeartbeatSeconds": 120,
    "DashboardBaseUrl": "http://localhost:3000"
  },
  "Agents": {
    "Profiles": [
      {
        "Name": "Codex",
        "Executable": "codex",
        "Arguments": [ "exec", "--approve-for-me", "-" ],
        "PromptDelivery": "stdin",
        "TimeoutMinutes": 90,
        "QuotaSignatures": [ "quota", "usage limit" ],
        "VersionArguments": [ "--version" ],
        "AvailabilityTimeoutSeconds": 5,
        "QuotaCooldownHours": 5,
        "QuotaResetPattern": "(?:resets?|try again)\\s+(?:at|in)\\s+(?<value>\\d{1,2}(?::\\d{2})?\\s*[ap]\\.?m\\.?|\\d+(?:\\.\\d+)?\\s*(?:hours?|hrs?|h|minutes?|mins?|m|days?|d))",
        "SupportsSessionResume": false,
        "SessionIdPattern": "session id: (?<sessionId>[0-9a-fA-F-]{36})",
        "ResumeArguments": [ "exec", "resume", "{SESSION_ID}", "--dangerously-bypass-approvals-and-sandbox", "-" ]
      },
      {
        "Name": "Claude",
        "Executable": "claude",
        "Arguments": [ "--print", "--dangerously-skip-permissions" ],
        "PromptDelivery": "argument",
        "TimeoutMinutes": 90,
        "QuotaSignatures": [ "rate limited" ],
        "VersionArguments": [ "--version" ],
        "AvailabilityTimeoutSeconds": 5,
        "QuotaCooldownHours": 5,
        "QuotaResetPattern": "(?:resets?|try again)\\s+(?:at|in)\\s+(?<value>\\d{1,2}(?::\\d{2})?\\s*[ap]\\.?m\\.?|\\d+(?:\\.\\d+)?\\s*(?:hours?|hrs?|h|minutes?|mins?|m|days?|d))",
        "SupportsSessionResume": false,
        "SessionIdPattern": "\"session_id\":\"(?<sessionId>[0-9a-fA-F-]{36})\"",
        "ResumeArguments": [ "--print", "--output-format", "json", "--resume", "{SESSION_ID}", "--dangerously-skip-permissions" ]
      }
    ]
  }
}
