FROM node:24-alpine AS build
WORKDIR /app
ARG FACTORY_PRODUCT_VERSION=Development
ARG FACTORY_SOURCE_COMMIT=unknown
ARG FACTORY_BUILD_TIME_UTC=
ARG FACTORY_BUILD_STATE=development
ARG NEXT_PUBLIC_FACTORY_API_URL=http://localhost:5080
ENV FACTORY_PRODUCT_VERSION=$FACTORY_PRODUCT_VERSION \
    FACTORY_SOURCE_COMMIT=$FACTORY_SOURCE_COMMIT \
    FACTORY_BUILD_TIME_UTC=$FACTORY_BUILD_TIME_UTC \
    FACTORY_BUILD_STATE=$FACTORY_BUILD_STATE \
    NEXT_PUBLIC_FACTORY_PRODUCT_VERSION=$FACTORY_PRODUCT_VERSION \
    NEXT_PUBLIC_FACTORY_SOURCE_COMMIT=$FACTORY_SOURCE_COMMIT \
    NEXT_PUBLIC_FACTORY_BUILD_TIME_UTC=$FACTORY_BUILD_TIME_UTC \
    NEXT_PUBLIC_FACTORY_BUILD_STATE=$FACTORY_BUILD_STATE \
    NEXT_PUBLIC_FACTORY_API_URL=$NEXT_PUBLIC_FACTORY_API_URL
COPY web/Factory.Web/package*.json ./
RUN npm install
COPY web/Factory.Web/ ./
COPY scripts/factory-build-identity.mjs /scripts/factory-build-identity.mjs
RUN npm run build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
